    {
      "parameters": {
        "jsCode": "const docs = items.map(i => i.json.document ? i.json.document.pageContent : (i.json.pageContent || JSON.stringify(i.json)));\nconst contexto = docs.join('\n---\n');\nconst webhookData = $('Webhook').first().json.body;\nconst perfil = $('Edit Fields').first().json.perfil_usuario;\nreturn [{ json: { contexto, chatInput: webhookData.chatInput, session_id: webhookData.session_id, perfil_usuario: perfil } }];"
      },
